#!/bin/busybox sh
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mount -t devtmpfs devtmpfs /dev
if [ -f /mtd.ko ]; then
    for mod in mtd nandcore nand; do
        if ! /bin/busybox insmod /"$mod".ko; then
            echo "LIFETIME-MODULE-LOAD: FAIL ($mod)"
            /bin/busybox poweroff -f
        fi
    done
fi
collision=0
case "$(/bin/busybox cat /proc/cmdline)" in
    *expect_collision=1*) collision=1 ;;
esac
if /bin/busybox insmod /retained_lifetime_test.ko expect_collision="$collision" &&
   echo 1 > /sys/module/retained_lifetime_test/parameters/run &&
   /bin/busybox rmmod retained_lifetime_test; then
    echo "MTD-LIFETIME-QEMU: PASS"
else
    echo "MTD-LIFETIME-QEMU: FAIL"
fi
if /bin/busybox insmod /raw_nand_lifetime_test.ko &&
   echo 1 > /sys/module/raw_nand_lifetime_test/parameters/run &&
   /bin/busybox rmmod raw_nand_lifetime_test; then
    echo "RAW-NAND-LIFETIME-QEMU: PASS"
else
    echo "RAW-NAND-LIFETIME-QEMU: FAIL"
fi
if /bin/busybox insmod /otp_lifetime_test.ko &&
   echo 1 > /sys/module/otp_lifetime_test/parameters/run &&
   /bin/busybox rmmod otp_lifetime_test; then
    echo "OTP-LIFETIME-QEMU: PASS"
else
    echo "OTP-LIFETIME-QEMU: FAIL"
fi
if [ -f /review_lifetime_test.ko ]; then
    if /bin/busybox insmod /review_lifetime_test.ko &&
       echo 1 > /sys/module/review_lifetime_test/parameters/run &&
       /bin/busybox rmmod review_lifetime_test; then
        echo "REVIEW-LIFETIME-QEMU: PASS"
    else
        echo "REVIEW-LIFETIME-QEMU: FAIL"
    fi
fi
if [ -f /mtd.ko ]; then
    for mod in nand nandcore mtd; do
        if /bin/busybox rmmod "$mod"; then
            echo "LIFETIME-MODULE-UNLOAD: PASS ($mod)"
        else
            echo "LIFETIME-MODULE-UNLOAD: FAIL ($mod)"
        fi
    done
fi
/bin/busybox poweroff -f
