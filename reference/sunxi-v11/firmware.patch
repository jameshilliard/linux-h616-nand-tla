+static int sunxi_nfc_allwinner_oob_attach_chip(struct nand_chip *nand)
+{
+	struct sunxi_nand_chip *sunxi_nand = to_sunxi_nand(nand);
+	struct sunxi_nfc *nfc = to_sunxi_nfc(nand->controller);
+	const struct sunxi_nfc_user_data_layout *layout = nfc->caps->layout;
+	int ret;
+
+	if (nand->ecc.engine_type != NAND_ECC_ENGINE_TYPE_ON_HOST)
+		return dev_err_probe(nfc->dev, -EINVAL,
+				     "Allwinner OOB format requires controller ECC\n");
+
+	if (nand->badblockpos != 0)
+		return dev_err_probe(nfc->dev, -EINVAL,
+				     "Allwinner OOB format requires the bad block marker at offset 0\n");
+
+	sunxi_nand->allwinner_oob = true;
+	if (nfc->caps->reg_user_data_len)
+		layout = &sunxi_nfc_allwinner_prefix_layout;
+	nand->options |= NAND_NEED_SCRAMBLING | NAND_NO_SUBPAGE_WRITE;
+	ret = sunxi_nand_hw_ecc_ctrl_init(nand, &nand->ecc, layout);
+	if (ret)
+		return ret;
+
+	/* Do not let the NAND core switch this format to software ECC. */
+	if (nand->ecc.size > nand_to_mtd(nand)->writesize)
+		return -EINVAL;
+
+	/* This format's spare and all-zero checks classify the whole page. */
+	nand->ecc.read_subpage = sunxi_nfc_allwinner_oob_read_subpage;
+	return 0;
+}
