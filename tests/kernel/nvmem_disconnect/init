#!/bin/sh
export PATH=/bin
/bin/busybox --install -s /bin
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev

fail() {
	echo "NVMEM-DETACH-QEMU: FAIL ($*)"
	poweroff -f
	exit 1
}

for phase in 1 2 3; do
	insmod /nvmem_detach_holder.ko || fail holder
	insmod /nvmem_detach_provider.ko || fail provider
	param=/sys/module/nvmem_detach_holder/parameters
	echo 1 > "$param/command" || fail acquire
	echo "$phase" > "$param/phase" || fail phase
	echo 2 > "$param/command" || fail start
	count=0
	while [ "$(cat "$param/command")" != 1 ]; do
		count=$((count + 1))
		[ "$count" -lt 100 ] || fail entered
		sleep 0.02
	done
	rmmod nvmem_detach_provider &
	remover=$!
	sleep 0.2
	kill -0 "$remover" || fail "unregister did not drain phase $phase"
	echo 3 > "$param/command" || fail unblock
	wait "$remover" || fail "module pinned instead of detached"
	echo 4 > "$param/command" || fail "late consumer access phase $phase"
	# Reuse the same provider name while the previous bare device is retained.
	insmod /nvmem_detach_provider.ko || fail replacement
	rmmod nvmem_detach_provider || fail replacement_remove
	echo 5 > "$param/command" || fail final_put
	rmmod nvmem_detach_holder || fail holder_remove
	echo "NVMEM-DETACH-QEMU: phase $phase PASS"
done
insmod /nvmem_detach_holder.ko || fail layout_holder
insmod /nvmem_detach_provider.ko dynamic=1 || fail layout_provider
param=/sys/module/nvmem_detach_holder/parameters
echo 1 > "$param/command" || fail layout_acquire
echo 3 > "$param/phase"
echo 2 > "$param/command" || fail layout_start
count=0
while [ "$(cat "$param/command")" != 1 ]; do
	count=$((count + 1))
	[ "$count" -lt 100 ] || fail layout_entered
	sleep 0.02
done
for path in /sys/bus/nvmem-layout/devices/*; do
	layout=${path##*/}
done
echo "$layout" > /sys/bus/nvmem-layout/drivers/detach-layout/unbind &
remover=$!
sleep 0.2
kill -0 "$remover" || fail layout_drain
echo 3 > "$param/command" || fail layout_unblock
wait "$remover" || fail layout_unbind
echo 0 > "$param/phase"
echo 6 > "$param/command" || fail retired_cell
echo "$layout" > /sys/bus/nvmem-layout/drivers/detach-layout/bind || fail layout_rebind
echo 7 > "$param/command" || fail replacement_cell
echo 6 > "$param/command" || fail old_cell_revived
rmmod nvmem_detach_provider || fail layout_provider_unload
echo 4 > "$param/command" || fail layout_stale_consumer
echo 5 > "$param/command" || fail layout_bare_put
rmmod nvmem_detach_holder || fail layout_holder_unload
echo "NVMEM-DETACH-QEMU: layout unbind and rebind PASS"
# Let DEBUG_KOBJECT_RELEASE run after both fixture modules have unloaded.
sleep 8
echo "NVMEM-DETACH-QEMU: PASS"
poweroff -f
